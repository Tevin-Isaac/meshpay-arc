# Copy to .env (never commit it). Leave all Daraja values empty to run in MOCK mode: no Safaricom, no money.
PORT=8787
MPESA_MODE=mock                 # mock | sandbox | production. Falls back to mock if credentials are missing.

# STK Push transaction type: paybill (CustomerPayBillOnline, default) or till (CustomerBuyGoodsOnline)
MPESA_TX_TYPE=paybill

# Daraja (sandbox/production only)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_BASE_URL=       # public HTTPS URL of this server, e.g. https://ramp.example.com
CALLBACK_SECRET=                # random, 24+ chars. Required in sandbox/production. Appended as ?token= to callbacks.
INITIATOR_NAME=                 # B2C initiator
SECURITY_CREDENTIAL=            # initiator password, RSA-encrypted with Safaricom's certificate, base64
B2C_SHORTCODE=

# Arc Testnet treasury (test USDC). Without a key payouts are SIMULATED (made-up tx hash) and cash out is off.
ARC_RPC_URL=https://rpc.testnet.arc.network
TREASURY_PRIVATE_KEY=
MESHPAY_ADDRESS=0xd619b77bb8389a632800c300969ef152099f7691   # enables cash out paid from the MeshPay reserve

# Pricing and limits
USD_KES_RATE=129
FEE_BPS=100
MIN_KES=10
MAX_KES=150000                  # cap per request
ALLOWED_ORIGINS=*               # must be your web origin(s) in sandbox/production, e.g. https://wayamesh.xyz
DATA_FILE=./data/orders.json
