# Copy to .env (never commit .env). Only VITE_* values reach the browser bundle.
# MeshPayV2 on Arc Testnet (public address, not a secret)
VITE_MESHPAY_ADDRESS=0xd619b77bb8389a632800c300969ef152099f7691
# Must equal the contract WITHDRAW_DELAY (seconds)
VITE_MESHPAY_DELAY=86400
# Leave unset for testnet. "mainnet" is refused unless a mainnet MeshPayV2 address is set.
# VITE_NETWORK=
# Where the app is mounted. "/" for a root deploy, "/app-static/" for wayamesh.xyz/app
# VITE_BASE=/
# Ramp server (ramp-server/) base URL. In dev the Vite proxy /ramp-api -> :8787 is used when unset.
# VITE_RAMP_API_URL=
# Circle onramp sandbox widget (optional, used by scripts/onramp-server.ts)
# CIRCLE_API_KEY=
